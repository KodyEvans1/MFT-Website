{
  "name": "mft-care-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-site.js",
    "test": "node --test tests/*.test.js && node src/validate.js",
    "check": "npm run build && npm test",
    "test:safety": "node --test tests/*.test.js",
    "verify:publication": "node tests/full-site.cjs",
    "geo:refresh": "node scripts/import-wa-geographies.js",
    "build:refresh-geography": "npm run geo:refresh && npm run build",
    "geo:verify": "node scripts/import-wa-geographies.js --dry-run"
  },
  "engines": {
    "node": ">=20"
  }
}
